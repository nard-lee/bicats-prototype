# Copy this file to server/.env and fill in the values.
#
# server/.env is the only env file the app reads (server/src/utils/load-env.ts
# resolves it from its own location, so it loads from any working directory).
# The repo-root .env.local is read afterward for keys left unset here — that is
# where `neon env pull` writes — and it can never override a value set here.

PORT=3000
NODE_ENV=development

# Postgres connection string
DATABASE_URL="postgresql://postgres:admin@localhost:9147/bicats?schema=public"

# Frontend origin (Vite dev server). Also the base for the tracking links that
# go out in resident SMS and email, so it must be the address they can open.
CORS_ORIGIN=http://localhost:5173

# Secrets — generate your own. e.g.:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
# Access-token lifetime in seconds. Keep it short; refresh tokens do the
# long-lived session work.
JWT_EXPIRES_IN=900

CSRF_SECRET=replace-with-another-long-random-string

# Optional (defaults to 30 days)
# REFRESH_TOKEN_EXPIRES_IN=30

# Optional SMS (UniSMS PH — https://unismsapi.com). Leave the key blank to disable.
# UNISMS_SECRET_KEY=sk_your_secret_key
# UNISMS_SENDER_ID=KABAYANIHAN
# UNISMS_API_URL=https://unismsapi.com/api/sms

# Optional email (Brevo — https://brevo.com). Leave the key blank to disable.
# BREVO_API_KEY=xkeysib-your-api-key
# BREVO_SENDER_EMAIL=no-reply@yourdomain.com
# BREVO_SENDER_NAME=Barangay Kabayanihan

# Optional Neon object storage (S3-compatible). When all three AWS vars are set,
# uploads (evidence and settings images) go to the bucket and are served through
# GET /api/assets/<name> instead of the local uploads folder. `neon env pull`
# writes the four AWS_* values for the checked-out branch into the repo-root
# .env.local, which this app now loads automatically — leave them commented here
# to force local-disk uploads.
# STORAGE_BUCKET=assets
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL_S3=
# AWS_REGION=

# Dev only, and only when object storage is off: the origin used to build
# /uploads/<name> evidence URLs (server/src/modules/complaint/complaint.helpers.ts).
# Defaults to http://localhost:3000, which is where `pnpm dev:server` listens.
# PUBLIC_API_URL=http://localhost:3000
