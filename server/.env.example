# Copy this file to .env and fill in the values.

PORT=3000
NODE_ENV=development

# Postgres connection string
DATABASE_URL="postgresql://postgres:admin@localhost:9147/bicats?schema=public"

# Frontend origin (Vite dev server)
CORS_ORIGIN=http://localhost:5173

# Secrets — generate your own. e.g.:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=86400

CSRF_SECRET=replace-with-another-long-random-string

# Optional (defaults to 30 days)
# REFRESH_TOKEN_EXPIRES_IN=30

# Optional SMS (UniSMS PH — https://unismsapi.com). Leave the key blank to disable.
# UNISMS_SECRET_KEY=sk_your_secret_key
# UNISMS_SENDER_ID=Unisoft
# UNISMS_API_URL=https://unismsapi.com/api/sms

# Optional email (Brevo — https://brevo.com). Leave the key blank to disable.
# BREVO_API_KEY=xkeysib-your-api-key
# BREVO_SENDER_EMAIL=no-reply@yourdomain.com
# BREVO_SENDER_NAME=BICATS

# Optional Neon object storage (S3-compatible). When all three AWS vars are set,
# uploads (evidence and settings images) go to the bucket and are served through
# GET /api/assets/<name> instead of the local uploads folder. `neon env pull`
# writes these into the repo-root .env.local — export them into the process
# (or set them on the host) to enable.
# STORAGE_BUCKET=assets
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL_S3=
# AWS_REGION=
