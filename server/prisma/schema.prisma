generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---- Staff accounts (created by an admin, no public registration) ----
model User {
  id           Int      @id @default(autoincrement())
  fullName     String
  position     String
  email        String   @unique
  phone        String   @unique
  username     String   @unique
  passwordHash String
  role         String   @default("staff") // "admin" | "staff" | "secretary" | "lupon"
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]
  statusUpdates StatusUpdate[]
  notices       Notice[]
  notifications Notification[]
  hearings      Hearing[]
  auditLogs     AuditLog[]

  // Staff management filters
  @@index([role, isActive])
  @@index([createdAt])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String    @unique
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
}

// ---- Complaints ----
model Complaint {
  id        Int    @id @default(autoincrement())
  reference String @unique // e.g. SI-2026-K7M4Q9

  // Complainant
  complainantName    String
  complainantAge     Int
  complainantPurok   String
  complainantContact String
  contactNormalized  String
  complainantEmail   String? // optional; used for email updates
  complainantAddress String

  // Respondent
  respondentName    String
  respondentAddress String?
  relationship      String?

  // Incident
  complaintType String
  incidentAt    DateTime
  incidentPlace String
  narrative     String

  // received | summoned | mediation | conciliation | settled | certified | dismissed
  status    String    @default("received")
  // low | normal | high | urgent (auto-escalated when a deadline lapses)
  priority  String    @default("normal")
  // Deadline for the next Katarungang Pambarangay step (null for terminal cases)
  dueAt     DateTime?
  consentAt DateTime
  viewedAt  DateTime? // first time staff opened the case; null = unopened
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  evidence Evidence[]
  updates  StatusUpdate[]
  notifications Notification[]
  hearings Hearing[]

  // Public tracking by normalized contact
  @@index([contactNormalized])
  // Staff complaint lists, newest first within each status
  @@index([status, createdAt])
  // Overdue open cases
  @@index([status, dueAt])
  // Priority triage and escalation
  @@index([priority, createdAt])
  // Unopened-first staff lists
  @@index([viewedAt, updatedAt])
  // Date-based reports and chronological filtering
  @@index([createdAt])
  @@index([incidentAt])
  // Reports filtered by complaint type and date
  @@index([complaintType, createdAt])
}

// ---- Uploaded files (metadata only) ----
model Evidence {
  id           Int       @id @default(autoincrement())
  complaintId  Int
  complaint    Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  originalName String
  storedName   String    @unique
  mimeType     String
  size         Int
  createdAt    DateTime  @default(now())

  // Evidence belonging to a complaint, newest first
  @@index([complaintId, createdAt])
}

// ---- Timeline: every status change ----
model StatusUpdate {
  id           Int       @id @default(autoincrement())
  complaintId  Int
  complaint    Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  status       String
  publicNote   String?
  internalNote String?
  hearingAt    DateTime?
  createdById  Int?
  createdBy    User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())

  // Complaint timeline, oldest or newest first
  @@index([complaintId, createdAt])
  // Filter history by staff member
  @@index([createdById])
  // Find upcoming mediation sessions and hearings
  @@index([hearingAt])
}

// ---- Scheduled hearings / mediation sessions ----
model Hearing {
  id          Int       @id @default(autoincrement())
  complaintId Int
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  scheduledAt DateTime
  // mediation | conciliation | hearing
  kind        String    @default("mediation")
  // scheduled | completed | cancelled | no_show
  status      String    @default("scheduled")
  location    String?
  notes       String?
  outcome     String?
  createdById Int?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Calendar range queries
  @@index([scheduledAt])
  // A case's hearing history
  @@index([complaintId, scheduledAt])
  // Status-filtered scheduling lists
  @@index([status, scheduledAt])
}

// ---- Notice board on the Home page ----
model Notice {
  id          Int      @id @default(autoincrement())
  title       String
  body        String
  isPublished Boolean  @default(true)
  createdById Int?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  // Published notices ordered by creation date
  @@index([isPublished, createdAt])
  // Filter notices created by a particular staff member
  @@index([createdById])
}

// ---- In-app notifications (deadline reminders, alerts) ----
model Notification {
  id          Int        @id @default(autoincrement())
  userId      Int
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String     @default("info") // reminder | overdue | info
  title       String
  body        String
  complaintId Int?
  complaint   Complaint? @relation(fields: [complaintId], references: [id], onDelete: SetNull)
  reference   String?
  // Prevents duplicate reminders for the same case/day/user
  dedupeKey   String?    @unique
  readAt      DateTime?
  createdAt   DateTime   @default(now())

  // Unread-first inbox per user
  @@index([userId, readAt, createdAt])
  // Retention / cleanup scans
  @@index([createdAt])
}

// ---- Audit trail: who did what, when ----
model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  // Snapshots so the log survives account deletion / renames.
  actorName  String?
  actorRole  String?
  action     String   // e.g. complaint.status.update
  entityType String   // complaint | user | hearing | notice | auth
  entityId   Int?
  summary    String
  meta       Json?
  ip         String?
  createdAt  DateTime @default(now())

  // Global activity feed, newest first
  @@index([createdAt])
  // Filter the feed by entity type / action
  @@index([entityType, createdAt])
  @@index([action, createdAt])
  // "What did this person do?" queries
  @@index([actorId, createdAt])
}

// ---- Barangay profile / letterhead, used by printable KP documents ----
model BarangaySettings {
  id             Int      @id @default(1)
  barangayName   String   @default("Barangay Kabayanihan")
  city           String   @default("City of Baguio")
  province       String   @default("Benguet")
  address        String   @default("")
  contactNumber  String   @default("")
  email          String   @default("")
  officeHours    String   @default("Monday–Friday, 8:00 AM – 5:00 PM")
  punongBarangay String   @default("Hon. Mario D. Santos")
  luponChairman  String   @default("Mr. Pedro A. Reyes")
  updatedAt      DateTime @updatedAt
}

