generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---- Closed value sets ----
// Keep these in sync with the TS unions in src/utils/roles.ts,
// src/modules/complaint/complaint.schema.ts, and complaint.eligibility.ts.
enum Role {
  admin
  staff
  secretary
  lupon
}

enum ComplaintStatus {
  received
  summoned
  mediation
  conciliation
  settled
  certified
  dismissed
}

// Public intake types; type12 ("Others") carries a free-text description.
enum ComplaintType {
  type1
  type2
  type3
  type4
  type5
  type6
  type7
  type8
  type9
  type10
  type11
  type12
}

enum EligibilityStatus {
  unreviewed
  eligible
  needs_review
  outside_kp
  rejected
}

// ---- Staff accounts (created by an admin, no public registration) ----
model User {
  id           Int      @id @default(autoincrement())
  fullName     String
  position     String
  email        String   @unique
  phone        String   @unique
  username     String   @unique
  passwordHash String
  role         Role     @default(staff)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]
  statusUpdates StatusUpdate[]
  serviceRecords ServiceRecord[]
  notices       Notice[]
  notifications Notification[]
  hearings      Hearing[]
  auditLogs     AuditLog[]

  // Staff management filters
  @@index([role, isActive])
  @@index([createdAt])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  // SHA-256 of the token sent to the client. A dump of this table yields
  // strings that cannot be spent.
  tokenHash String    @unique
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  // Keep the refresh cookie persistent across browser restarts.
  remember  Boolean   @default(false)
  createdAt DateTime  @default(now())
  revokedAt DateTime?
}

// ---- Lupong Tagapamayapa roster (picked per case, no accounts needed) ----
model LuponMember {
  id        Int      @id @default(autoincrement())
  fullName  String
  contact   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, fullName])
}

// ---- Per-month sequential reference counter (26-10-0001) ----
model ReferenceCounter {
  period    String   @id // YY-MM of the month being numbered
  lastValue Int
  createdAt DateTime @default(now())
}

// ---- Complaints ----
model Complaint {
  id        Int    @id @default(autoincrement())
  reference String @unique // e.g. 26-10-0001

  // Complainant
  complainantName    String
  complainantAge     Int
  complainantPurok   String
  complainantContact String
  contactNormalized  String
  complainantEmail   String? // optional; used for email updates
  complainantAddress String
  // Language the filing form was in when the case came in; picks the SMS and
  // email templates. Existing cases default to English.
  complainantLang    String @default("en") // "en" | "tl"

  // Respondent
  respondentName    String
  respondentAddress String?
  relationship      String?

  // Incident
  complaintType      ComplaintType
  complaintTypeOther String? // free-text description when complaintType = type12
  incidentAt    DateTime
  incidentPlace String
  narrative     String

  status    ComplaintStatus   @default(received)
  // Deadline for the next Katarungang Pambarangay step (null for terminal cases)
  dueAt     DateTime?
  consentAt DateTime
  viewedAt  DateTime? // first time staff opened the case; null = unopened

  // KP eligibility screening captured at intake, plus the staff decision
  eligibilityStatus     EligibilityStatus @default(unreviewed)
  eligibilityAnswers    Json?
  eligibilityNotes      String?
  eligibilityReason     String?
  eligibilityReviewedAt DateTime?

  // Pangkat ng Tagapagkasundo: the three lupon members picked for the case,
  // snapshotted as {id, fullName, isChairman} so roster edits never rewrite
  // an old record. The chairman name is also mirrored into the column below
  // for the printed documents and for cases recorded before the panel existed.
  pangkatMembers  Json?
  pangkatChairman String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  evidence Evidence[]
  updates  StatusUpdate[]
  serviceRecords ServiceRecord[]
  notifications Notification[]
  hearings Hearing[]

  // Public tracking by normalized contact
  @@index([contactNormalized])
  // Staff complaint lists, newest first within each status
  @@index([status, createdAt])
  // Overdue open cases
  @@index([status, dueAt])
  // Unopened-first staff lists
  @@index([viewedAt, updatedAt])
  // Date-based reports and chronological filtering
  @@index([createdAt])
  @@index([incidentAt])
  // Reports filtered by complaint type and date
  @@index([complaintType, createdAt])
}

// ---- Uploaded files (metadata only) ----
model Evidence {
  id           Int       @id @default(autoincrement())
  complaintId  Int
  complaint    Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  originalName String
  storedName   String    @unique
  mimeType     String
  size         Int
  createdAt    DateTime  @default(now())

  // Evidence belonging to a complaint, newest first
  @@index([complaintId, createdAt])
}

// ---- Timeline: every status change ----
model StatusUpdate {
  id           Int       @id @default(autoincrement())
  complaintId  Int
  complaint    Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  status       ComplaintStatus
  publicNote   String?
  internalNote String?
  hearingAt    DateTime?
  createdById  Int?
  createdBy    User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())

  // Complaint timeline, oldest or newest first
  @@index([complaintId, createdAt])
  // Filter history by staff member
  @@index([createdById])
  // Find upcoming mediation sessions and hearings
  @@index([hearingAt])
}

// ---- Proof of service for the summons / notices ----
model ServiceRecord {
  id          Int       @id @default(autoincrement())
  complaintId Int
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  servedAt    DateTime
  serverName  String
  // received | refused | not_found
  result      String
  notes       String?
  createdById Int?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  // A case's service attempts, newest first
  @@index([complaintId, servedAt])
  @@index([createdById])
}

// ---- Scheduled hearings / mediation sessions ----
model Hearing {
  id          Int       @id @default(autoincrement())
  complaintId Int
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  scheduledAt DateTime
  // mediation | conciliation | hearing
  kind        String    @default("mediation")
  // scheduled | completed | cancelled | no_show
  status      String    @default("scheduled")
  location    String?
  notes       String?
  outcome     String?
  // present | absent | excused (null = not yet recorded)
  complainantAttendance String?
  respondentAttendance  String?
  attendanceNotes       String?
  attendanceRecordedAt  DateTime?
  createdById Int?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Calendar range queries
  @@index([scheduledAt])
  // A case's hearing history
  @@index([complaintId, scheduledAt])
  // Status-filtered scheduling lists
  @@index([status, scheduledAt])
}

// ---- Notice board on the Home page ----
model Notice {
  id          Int      @id @default(autoincrement())
  title       String
  body        String
  isPublished Boolean  @default(true)
  createdById Int?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  // Published notices ordered by creation date
  @@index([isPublished, createdAt])
  // Filter notices created by a particular staff member
  @@index([createdById])
}

// ---- In-app notifications (deadline reminders, alerts) ----
model Notification {
  id          Int        @id @default(autoincrement())
  userId      Int
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String    @default("info") // reminder | overdue | escalation | hearing_overdue | hearing_upcoming | new_complaint | info
  title       String
  body        String
  complaintId Int?
  complaint   Complaint? @relation(fields: [complaintId], references: [id], onDelete: SetNull)
  reference   String?
  // Prevents duplicate reminders for the same case/day/user
  dedupeKey   String?    @unique
  readAt      DateTime?
  createdAt   DateTime   @default(now())

  // Unread-first inbox per user
  @@index([userId, readAt, createdAt])
  // Retention / cleanup scans
  @@index([createdAt])
}

// ---- Audit trail: who did what, when ----
model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  // Snapshots so the log survives account deletion / renames.
  actorName  String?
  actorRole  String?
  action     String   // e.g. complaint.status.update
  entityType String   // complaint | user | hearing | notice | auth
  entityId   Int?
  summary    String
  meta       Json?
  ip         String?
  createdAt  DateTime @default(now())

  // Global activity feed, newest first
  @@index([createdAt])
  // Filter the feed by entity type / action
  @@index([entityType, createdAt])
  @@index([action, createdAt])
  // "What did this person do?" queries
  @@index([actorId, createdAt])
}

// ---- Barangay profile / letterhead, used by printable KP documents ----
model BarangaySettings {
  id             Int      @id @default(1)
  barangayName   String   @default("Barangay Kabayanihan")
  city           String   @default("City of Baguio")
  province       String   @default("Benguet")
  address        String   @default("")
  contactNumber  String   @default("")
  email          String   @default("")
  officeHours    String   @default("Monday–Friday, 8:00 AM – 5:00 PM")
  punongBarangay String   @default("Hon. Mario D. Santos")
  secretaryName  String   @default("")

  // Branding assets (paths under /uploads; empty falls back to the default seal)
  logoUrl               String @default("")
  punongSignatureUrl    String @default("")
  secretarySignatureUrl String @default("")

  // Signatory titles printed under the names. RA 7160 §409 makes the Punong
  // Barangay the chairman of the Lupong Tagapamayapa, so one official carries
  // both titles; the Pangkat chairman is not a standing officer and is instead
  // recorded per case (Complaint.pangkatChairman).
  punongTitle    String @default("Punong Barangay / Chairman, Lupong Tagapamayapa")
  secretaryTitle String @default("Barangay Secretary / Secretary, Lupong Tagapamayapa")

  // Purok choices offered by the public filing form
  puroks String[] @default(["Session Road", "Assumption Road", "Mabini Street", "General Luna Road", "Fr. Carlu Street"])

  // The full Sangguniang Barangay as published on the site: one entry per
  // official, "Name — Position". Members of the Lupong Tagapamayapa are a
  // separate roster (LuponMember) and may repeat these names.
  officials String[] @default([])

  // Line printed under the barangay name on KP documents
  documentOfficeLine String @default("Office of the Punong Barangay")

  // Public contact channels shown on the website
  hotline     String @default("")
  tanodNumber String @default("")

  // Session scheduling defaults and guardrails
  defaultHearingLocation String  @default("Barangay Hall Session Room")
  hearingDurationMinutes Int     @default(60)
  officeStartHour        Int     @default(8)
  officeEndHour          Int     @default(17)
  enforceOfficeHours     Boolean @default(false)
  hearingGraceHours      Int     @default(2)

  // KP deadlines (days) and the "due soon" warning window
  deadlineReceived     Int @default(1)  // issue the summons by the next working day
  deadlineSummoned     Int @default(15) // hold/complete mediation from the first meeting
  deadlineMediation    Int @default(15) // conclude mediation before constituting the Pangkat
  deadlineConciliation Int @default(15) // conclude Pangkat conciliation (extendable +15)
  riskWindowDays       Int @default(3)

  // Count deadline days on working days only, skipping weekends and holidays
  workingDaysOnly Boolean  @default(false)
  holidays        String[] @default([])

  // Complainant notifications per event and channel
  notifyIntakeSms      Boolean @default(true)
  notifyIntakeEmail    Boolean @default(true)
  notifyStatusSms      Boolean @default(true)
  notifyStatusEmail    Boolean @default(true)
  notifyMediationSms   Boolean @default(true)
  notifyMediationEmail Boolean @default(true)
  notifyCancelledSms   Boolean @default(true)
  notifyCancelledEmail Boolean @default(true)
  reminderLeadHours    Int     @default(24)

  updatedAt DateTime @updatedAt
}

